# ==============================================================================
# EV Cluster Load Environment Configuration Template
# DO NOT COMMIT SECRETS OR SENSITIVE TOKENS TO GIT
# ==============================================================================

# Database Connection (TimescaleDB / PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evcluster

# Security & JWT Authentication
# In production, replace JWT_SECRET_KEY with a secure randomly generated secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed Demo Accounts
DEMO_JUDGE_USERNAME=judge_demo
DEMO_JUDGE_PASSWORD=JudgeDemo2026!
DEMO_OPERATOR_C1_USERNAME=operator_c1
DEMO_OPERATOR_C1_PASSWORD=OperatorC1_2026!
DEMO_OPERATOR_C2_USERNAME=operator_c2
DEMO_OPERATOR_C2_PASSWORD=OperatorC2_2026!
DEMO_DRIVER_USERNAME=driver_demo
DEMO_DRIVER_PASSWORD=DriverDemo2026!
DEMO_ADMIN_USERNAME=admin_demo
DEMO_ADMIN_PASSWORD=AdminDemo2026!

# Optional Ingestion Adapters Tokens
ACN_DATA_TOKEN=
